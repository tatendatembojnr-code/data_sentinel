<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_data_sentinel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.data_sentinel</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Data Sentinel" string="Data Sentinel" name="data_sentinel">
                    
                    <!-- 0. BACKUP STATUS & QUICK ACTIONS -->
                    <block title="Data Sentinel Status &amp; Logs" name="status_quick_actions_block">
                        <setting id="quick_actions_setting" help="View complete backup history, inspect real-time execution logs, or trigger an instant snapshot to Nextcloud now.">
                            <div class="mt8 d-flex gap-2 flex-wrap">
                                <button name="action_view_backups" type="object"
                                        string="View All Backups &amp; Audit Logs" class="btn btn-primary"
                                        icon="fa-list"/>
                                <button name="action_trigger_instant_backup" type="object"
                                        string="Run Instant Snapshot Now" class="btn btn-secondary"
                                        icon="fa-cloud-upload"
                                        confirm="Trigger an immediate snapshot backup to Nextcloud now?"/>
                            </div>
                        </setting>
                    </block>

                    <!-- 1. NEXTCLOUD WEBDAV INTEGRATION -->
                    <block title="Nextcloud WebDAV Storage Configuration" name="nextcloud_config_block">
                        <setting id="nextcloud_url_setting" help="Specify the WebDAV endpoint URL for Nextcloud (e.g. https://domain.com/remote.php/dav/files/username).">
                            <field name="data_sentinel_nextcloud_url" placeholder="https://vmi3020185.contaboserver.net/remote.php/dav/files/admin"/>
                        </setting>
                        <setting id="nextcloud_auth_setting" help="Nextcloud user credentials or generated App Password.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="data_sentinel_nextcloud_user" class="col-lg-3 o_light_label" string="Username"/>
                                    <field name="data_sentinel_nextcloud_user" class="col-lg-9"/>
                                </div>
                                <div class="row mt8">
                                    <label for="data_sentinel_nextcloud_password" class="col-lg-3 o_light_label" string="Password"/>
                                    <field name="data_sentinel_nextcloud_password" password="True" class="col-lg-9"/>
                                </div>
                                <div class="row mt8">
                                    <label for="data_sentinel_nextcloud_root_dir" class="col-lg-3 o_light_label" string="Root Directory"/>
                                    <field name="data_sentinel_nextcloud_root_dir" class="col-lg-9"/>
                                </div>
                                <div class="row mt8">
                                    <label for="data_sentinel_verify_ssl" class="col-lg-3 o_light_label" string="Verify SSL"/>
                                    <field name="data_sentinel_verify_ssl" class="col-lg-9"/>
                                </div>
                                <div class="mt16">
                                    <button name="action_test_nextcloud_connection" type="object"
                                            string="Test Nextcloud Connection" class="btn btn-primary"
                                            icon="fa-plug"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <!-- 2. FULL INSTANCE BACKUP SCHEDULER -->
                    <block title="Daily Full Instance Backup (Midnight)" name="full_backup_block">
                        <setting id="full_backup_active_setting" help="Automatically archive Postgres DB, Filestore, and Custom Addons every day at midnight.">
                            <field name="data_sentinel_full_active"/>
                            <div class="content-group" invisible="not data_sentinel_full_active">
                                <div class="row mt8">
                                    <label for="data_sentinel_full_time" class="col-lg-4 o_light_label" string="Run Time (24h)"/>
                                    <field name="data_sentinel_full_time" widget="float_time" class="col-lg-8"/>
                                </div>
                                <div class="row mt8">
                                    <span class="col-lg-4 o_light_label">Included Content</span>
                                    <div class="col-lg-8">
                                        <div><field name="data_sentinel_full_include_db"/> Database (pg_dump)</div>
                                        <div><field name="data_sentinel_full_include_filestore"/> Odoo Filestore</div>
                                        <div><field name="data_sentinel_full_include_addons"/> Custom Addons</div>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <!-- 3. TIMELY SNAPSHOT BACKUP SCHEDULER -->
                    <block title="Timely Snapshot Backups (Working Hours)" name="timely_backup_block">
                        <setting id="timely_backup_active_setting" help="Execute fast database and filestore snapshots at regular intervals during working hours.">
                            <field name="data_sentinel_timely_active"/>
                            <div class="content-group" invisible="not data_sentinel_timely_active">
                                <div class="row mt8">
                                    <label for="data_sentinel_timely_interval_hours" class="col-lg-4 o_light_label" string="Interval (Hours)"/>
                                    <field name="data_sentinel_timely_interval_hours" class="col-lg-8"/>
                                </div>
                                <div class="row mt8">
                                    <label for="data_sentinel_timely_start_hour" class="col-lg-4 o_light_label" string="Window Start (e.g. 5 AM)"/>
                                    <field name="data_sentinel_timely_start_hour" widget="float_time" class="col-lg-8"/>
                                </div>
                                <div class="row mt8">
                                    <label for="data_sentinel_timely_end_hour" class="col-lg-4 o_light_label" string="Window End (e.g. 8 PM)"/>
                                    <field name="data_sentinel_timely_end_hour" widget="float_time" class="col-lg-8"/>
                                </div>
                                <div class="row mt8">
                                    <span class="col-lg-4 o_light_label">Included Content</span>
                                    <div class="col-lg-8">
                                        <div><field name="data_sentinel_timely_include_db"/> Database</div>
                                        <div><field name="data_sentinel_timely_include_filestore"/> Filestore</div>
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <!-- 4. RETENTION & CLEANUP LIFECYCLE MANAGEMENT -->
                    <block title="Retention &amp; Deletion Lifecycle (Nextcloud &amp; Server)" name="retention_management_block">
                        <!-- Cloud Retention -->
                        <setting id="cloud_retention_setting" help="Configure how long backups remain stored in Nextcloud before automatic deletion.">
                            <div><field name="data_sentinel_cloud_retention_active"/> Enable Nextcloud Cloud Retention Policy</div>
                            <div class="content-group mt8" invisible="not data_sentinel_cloud_retention_active">
                                <div class="row mt8">
                                    <label for="data_sentinel_full_retention_days" class="col-lg-5 o_light_label" string="Full Backups Cloud Retention (Days)"/>
                                    <field name="data_sentinel_full_retention_days" class="col-lg-7"/>
                                </div>
                                <div class="row mt8">
                                    <label for="data_sentinel_timely_retention_days" class="col-lg-5 o_light_label" string="Snapshot Backups Cloud Retention (Days)"/>
                                    <field name="data_sentinel_timely_retention_days" class="col-lg-7"/>
                                </div>
                            </div>
                        </setting>

                        <!-- Local Server Retention -->
                        <setting id="local_storage_retention_setting" help="Configure local server backup storage and automatic deletion policies.">
                            <div><field name="data_sentinel_keep_local_copy"/> Keep Local Archive on Server</div>
                            <div class="content-group mt8" invisible="not data_sentinel_keep_local_copy">
                                <div><field name="data_sentinel_local_retention_active"/> Enable Server Retention Auto-Cleanup</div>
                                <div class="content-group mt8" invisible="not data_sentinel_local_retention_active">
                                    <div class="row mt8">
                                        <label for="data_sentinel_local_retention_days" class="col-lg-5 o_light_label" string="Delete Local Files Older Than (Days)"/>
                                        <field name="data_sentinel_local_retention_days" class="col-lg-7"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="data_sentinel_local_retention_count" class="col-lg-5 o_light_label" string="Keep Max Recent Copies (Count)"/>
                                        <field name="data_sentinel_local_retention_count" class="col-lg-7"/>
                                    </div>
                                </div>
                            </div>
                        </setting>

                        <!-- Immediate Purge Button -->
                        <setting id="run_cleanup_now_setting" help="Instantly purge expired backups on both Nextcloud and the local server based on configured retention policies.">
                            <div class="mt8">
                                <button name="action_run_cleanup_now" type="object"
                                        string="Purge Expired Backups Now" class="btn btn-secondary"
                                        icon="fa-trash"
                                        confirm="Are you sure you want to run the retention policy cleanup now? This will permanently delete expired backups from Nextcloud and the local server."/>
                            </div>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <!-- Settings Action -->
    <record id="action_data_sentinel_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'data_sentinel', 'bin_size': False}</field>
    </record>
</odoo>
